{
  "image": "ubuntu:24.04",
  "remoteUser": "dev",
  "overrideFeatureInstallOrder": ["./features/apt"],
  "features": {
    "./features/user": {
      "username": "dev"
    },
    "ghcr.io/devcontainers/features/node:1": {},
    "./features/apt": {
      "packages": "libatomic1"
    }
  },
  "postCreateCommand": "touch ~/.devcontainer-config-created",
  "postStartCommand": "touch ~/.devcontainer-config-started"
}
