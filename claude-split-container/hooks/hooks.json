{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|BashOutput|KillShell|Read|Write|Edit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/remind.mjs\""
          }
        ]
      }
    ]
  }
}
